                "switch.svitlo_3",
                "switch.zal_switch_2",
                "switch.zal_switch",
                "switch.svitlo_4",
                "switch.vitalnia_svitlo_switch",
                "switch.vitalnia_svitlo_switch_2",
                "switch.vimikach_switch_2",
                "switch.vimikach_switch",
                "switch.svitlo_switch",
                "switch.svitlo_switch_2",
                "switch.kabinet_vimikach_kabinet",
                "switch.pidsvitka",
                "switch.ditiacha_svitlo_switch",
                "switch.ditiacha_svitlo_switch_2",
                "switch.ditiacha_pidsvitka_terasi",
                "switch.svitlo_2",
                "switch.vimikach_bilia_vkhodu_switch_2",
                "switch.vimikach_bilia_vkhodu_switch",
                "switch.balkon_spalnia_svitlo_switch",
                "switch.lumi_lumi_ctrl_ln1_aq1",
                "switch.vitiazhka",
                "switch.svitlo",
                "switch.pralnia_switch"
