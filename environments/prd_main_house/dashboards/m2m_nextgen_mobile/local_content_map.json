{
  "dashboard_id": "m2m_nextgen_mobile",
  "theme_reference": "m2m_glass_carbon_neon",
  "background_image": "/local/liquid_glass/m2m_neon_splatter.jpg",
  "rebuild_meta": {
    "note": "spec v2.6.0 section 2.2 — fully independent MOBILE shell (operator directive 2026-08-10: two independent shells, full rebuild of both, not a shared-breakpoint variant of the desktop one). room_content / floor_actions / *_room_corner_actions / climate_room_content / laundry_room_content are reused 1:1 from the desktop m2m_nextgen map (same entities, STD-06 — no invented entities; same precedent as m2m_nextgen itself reusing svitlo's content 1:1). Only routing + layout_containers differ."
  },
  "ordering_policy": {
    "rule": "rooms inside each floor are ordered most-used-first by switch turn-on frequency",
    "runtime_engine": "ha_operator/room_usage_ranking.yaml — input_number.m2m_room_usage_* rolling 7-day counters + sensor.m2m_room_usage_order / sensor.m2m_room_usage_rank_1..3 live ranking sensors",
    "runtime_ui": "home header hosts m2m_top_rooms_shelf — three live rank chips (room label, weekly count, active/total lights) that reorder client-side as the rank sensors change",
    "static_seed": "this content map's include_floors order is the deterministic seed: tracked-switch count per room (descending), ties broken by global_spatial_topology.json order",
    "seed_ranking": {
      "floor_1": [
        "kukhnia",
        "zal",
        "vitalnia",
        "dushova",
        "skhody_i_korydor",
        "kabinet"
      ],
      "floor_2": [
        "ditiacha",
        "spalnia",
        "vanna",
        "tualet",
        "pralnia"
      ]
    }
  },
  "routing": {
    "mode": "spa",
    "views": [
      {
        "path": "home",
        "title": "Огляд",
        "layout_template": "layout/m2m_mobile_shell.yaml",
        "room_corner_actions_key": "light_room_corner_actions",
